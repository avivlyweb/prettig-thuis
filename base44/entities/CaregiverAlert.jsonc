{
  "name": "CaregiverAlert",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "ID of the patient/user"
    },
    "level": {
      "type": "string",
      "enum": [
        "info",
        "warning",
        "urgent"
      ],
      "default": "info"
    },
    "title": {
      "type": "string",
      "description": "Alert title"
    },
    "message": {
      "type": "string",
      "description": "Alert message"
    },
    "read": {
      "type": "boolean",
      "default": false
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "data": {
      "type": "object",
      "description": "Extra context data"
    }
  },
  "required": [
    "level",
    "title",
    "timestamp"
  ]
}